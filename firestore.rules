rules_version = '2';

// SEN-SEL Firestore 보안 규칙
//
// 역할 구분
// - 교사: 구글 로그인 (sign_in_provider != 'anonymous')
// - 학생: 학급 코드 입장 시 익명 로그인 → studentSessions/{uid}.classCode 에 자기 학급 기록
//
// 핵심 원칙
// - 학생은 자기 학급(classCode)의 students 문서만 읽고 쓸 수 있다.
// - 교사는 자기가 소유한 학급(classes.teacherUid == uid) 또는 공용 데모 학급(isDemo == true)의 데이터만 다룰 수 있다.
// - 로그인하지 않은 요청은 아무것도 읽거나 쓸 수 없다.
//
// 배포: firebase deploy --only firestore:rules  (또는 Firebase 콘솔 > Firestore > 규칙 탭에 붙여넣기)
// 주의: Firebase 콘솔 > Authentication > 로그인 방법에서 '익명' 제공업체를 사용 설정해야 학생 접속이 동작한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function classPath(code) {
      return /databases/$(database)/documents/classes/$(code);
    }

    function classExists(code) {
      return code is string && code.size() > 0 && exists(classPath(code));
    }

    // 교사가 해당 학급을 다룰 수 있는가 (소유자 또는 공용 데모 학급)
    function ownsClass(code) {
      return isTeacher() && classExists(code) && (
        get(classPath(code)).data.get('teacherUid', '') == request.auth.uid ||
        get(classPath(code)).data.get('isDemo', false) == true
      );
    }

    function sessionPath() {
      return /databases/$(database)/documents/studentSessions/$(request.auth.uid);
    }

    // 학생이 해당 학급으로 입장한 세션인가
    function inSessionClass(code) {
      return signedIn() && code is string && code.size() > 0 && exists(sessionPath()) && get(sessionPath()).data.get('classCode', '') == code;
    }

    // ===== 학급 =====
    match /classes/{code} {
      allow read: if signedIn(); // 학생: 학급 코드 검증 / 교사: 목록·정보
      allow create: if isTeacher() && request.resource.data.get('teacherUid', '') == request.auth.uid;
      allow update: if ownsClass(code) && (
        resource.data.get('isDemo', false) == true ||
        request.resource.data.get('teacherUid', '') == resource.data.get('teacherUid', '')
      );
      allow delete: if isTeacher() && resource.data.get('teacherUid', '') == request.auth.uid;
    }

    // ===== 교사 프로필 (챗봇 P-TISER 설정, SEL 학교급 등) =====
    match /teachers/{uid} {
      allow get: if signedIn();      // 학생 챗봇이 담당 교사의 설정을 읽음 (classes.teacherUid 경유)
      allow list: if isTeacher();    // 레거시 classCode 검색은 교사만
      allow create, update: if isTeacher() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ===== 학생 세션 (익명 uid ↔ 학급 코드) =====
    match /studentSessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && classExists(request.resource.data.get('classCode', ''));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ===== 학생 데이터 (대화, 기분, 관계 신호, 처방) =====
    match /students/{id} {
      allow read: if ownsClass(resource.data.get('classCode', '')) || inSessionClass(resource.data.get('classCode', ''));
      allow create: if ownsClass(request.resource.data.get('classCode', '')) || inSessionClass(request.resource.data.get('classCode', ''));
      allow update: if request.resource.data.get('classCode', '') == resource.data.get('classCode', '') && (
        ownsClass(resource.data.get('classCode', '')) || inSessionClass(resource.data.get('classCode', ''))
      );
      allow delete: if ownsClass(resource.data.get('classCode', ''));
    }

    // ===== 자리 배치도 (교사 전용) =====
    match /seatingCharts/{code} {
      allow read, write: if ownsClass(code);
    }

    // 그 외 컬렉션은 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
